{
  "name": "neska-music",
  "productName": "Neska Music",
  "version": "1.0.0",
  "description": "Neska Music - GLOBAL SOUND",
  "author": "Shines Dags",
  "main": "main.js",
  "private": true,
  "scripts": { "dist": "electron-builder --win nsis --x64 --publish never" },
  "devDependencies": { "electron": "^33.2.1", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "io.github.shinesdagsbot.neska",
    "productName": "Neska Music",
    "artifactName": "Neska-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neska Music"
    }
  }
}
